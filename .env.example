# Variáveis lidas pelo docker-compose.yml (interpolação ${VAR}) — copie este
# arquivo para ".env" (mesma pasta do docker-compose.yml) e preencha os
# valores reais. Esse ".env" NUNCA deve ser commitado (já está no .gitignore).
#
# Diferente de backend/.env.example: aquele é lido pelo backend diretamente
# quando rodado FORA do Docker; este aqui é lido pelo docker-compose para
# preencher as variáveis de ambiente dos containers.

# JWT — gere com: openssl rand -hex 32
SECRET_KEY=

# SendGrid — necessário para o e-mail de "esqueci minha senha" ser enviado de
# verdade. Sem isso, o backend loga o link em vez de enviar (funciona para
# teste, não para produção). Ver instruções em backend/app/core/email.py.
SENDGRID_API_KEY=
EMAIL_FROM=noreply@facilitadorsped.com.br

# URL pública do frontend — usada para montar o link de reset de senha no
# e-mail. Trocar para o domínio real em produção.
FRONTEND_URL=http://localhost:3000

# AWS S3 — sem AWS_ACCESS_KEY_ID configurada, o storage usa disco local
# (backend/app/core/storage.py) e continua funcionando normalmente em dev,
# desde que backend e celery_worker rodem no mesmo docker-compose (mesmo
# volume compartilhado). Preencher aqui liga o backend S3 automaticamente —
# necessário antes de qualquer deploy onde backend/celery_worker rodem como
# serviços separados sem disco compartilhado (ex. Railway).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=sa-east-1
S3_BUCKET=facilitador-sped
